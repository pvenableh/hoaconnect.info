{{!--
  The footer: the sign-off, the board of directors, the bottom band (address,
  contact, homepage, ©, and the class footer from Phase 3a — Unsubscribe ·
  Preferences · the postal address), then the building photo.

  `complianceFooter` must reach the HTML untouched: the send queue renders with
  a sentinel there and swaps in each recipient's footer after the claim
  (email-send-render.ts; tests/server/email-sender-unification.test.ts).
--}}
      <!-- Footer -->
      <mj-section background-color="{{footerBg}}" padding="{{footerPadding}}"{{footerBorder}}>
        <mj-column>
          <mj-text color="#374151" font-size="16px" padding-bottom="4px">{{salutation}},</mj-text>
          <mj-text color="#1f2937" font-size="16px" font-weight="600">{{orgName}}</mj-text>
        </mj-column>
      </mj-section>

      {{#if boardCells}}
      <mj-section padding="24px 32px 0 32px">
        <mj-column>
          <mj-divider border-width="1px" border-color="#e5e7eb" padding="0 0 24px 0" />
          <mj-text align="center" color="#6b7280" font-size="12px" text-transform="uppercase" letter-spacing="1px" padding-bottom="16px">
            Board of Directors
          </mj-text>
          <mj-table>
            <tr>{{boardCells}}</tr>
          </mj-table>
        </mj-column>
      </mj-section>
      {{/if}}

      <!-- Bottom Footer -->
      <mj-section background-color="{{bottomBg}}" padding="{{bottomPadding}}">
        <mj-column>
          {{#if addressLine}}
          <mj-text align="center" color="{{footerTextColor}}" font-size="12px">{{addressLine}}</mj-text>
          {{/if}}
          {{#if orgEmail}}
          <mj-text align="center" color="{{footerTextColor}}" font-size="12px" padding-top="4px">{{orgEmail}}</mj-text>
          {{/if}}
          {{#if homepageUrl}}
          <mj-text align="center" padding-top="6px" font-size="12px"><a href="{{homepageUrl}}" style="color: {{footerTextColor}}; text-decoration: underline;">{{homepageLabel}}</a></mj-text>
          {{/if}}
          <mj-text align="center" color="#6b7280" font-size="11px" padding-top="8px">
            © {{year}} {{legalName}}. All rights reserved.
          </mj-text>
          {{#if complianceFooter}}
          <mj-text align="center" color="#6b7280" font-size="11px" padding-top="8px">{{complianceFooter}}</mj-text>
          {{/if}}
        </mj-column>
      </mj-section>

      {{#if footerImageUrl}}
      <mj-section padding="0">
        <mj-column>
          <mj-image src="{{footerImageUrl}}" alt="{{orgName}}" padding="0" fluid-on-mobile="true" />
        </mj-column>
      </mj-section>
      {{/if}}
