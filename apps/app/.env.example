# =============================================================================
# HOA Connect (Property Flow) — environment variables
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Only the DIRECTUS + SESSION blocks are strictly required to boot the app;
# the rest enable individual features (email, payments, maps, AI, …).
# =============================================================================

# ===========================================
# DIRECTUS CMS  (required)
# ===========================================
DIRECTUS_URL=https://your-directus-instance.com
DIRECTUS_WEBSOCKET_URL=wss://your-directus-instance.com/websocket
# Admin static token — used by server utils AND every scripts/ schema migration.
DIRECTUS_STATIC_TOKEN=your-static-admin-token

# ===========================================
# SESSION  (required)
# ===========================================
# nuxt-auth-utils session encryption secret — must be at least 32 characters.
NUXT_SESSION_PASSWORD=your-session-password-min-32-chars

# ===========================================
# DIRECTUS ROLES (UUIDs from your Directus instance)
# ===========================================
# APP_ADMIN / HOA_ADMIN / MEMBER / PROPERTY_MANAGER have baked-in defaults in
# nuxt.config.ts; override only if your instance uses different role ids.
NUXT_PUBLIC_DIRECTUS_ROLE_ADMIN=your-admin-role-uuid
NUXT_PUBLIC_DIRECTUS_ROLE_USER=your-default-user-role-uuid
# NUXT_PUBLIC_DIRECTUS_ROLE_APP_ADMIN=
# NUXT_PUBLIC_DIRECTUS_ROLE_HOA_ADMIN=
# NUXT_PUBLIC_DIRECTUS_ROLE_MEMBER=
# NUXT_PUBLIC_DIRECTUS_ROLE_PROPERTY_MANAGER=

# ===========================================
# APPLICATION
# ===========================================
APP_URL=http://localhost:3000
FROM_EMAIL=noreply@your-domain.com
# Canonical app host (used for portal links, transactional email, custom-domain
# tenant resolution). Defaults to app.hoaconnect.info.
NUXT_PUBLIC_MAIN_DOMAIN=app.hoaconnect.info

# ===========================================
# MAPS & WEATHER  (optional — landing pages / location widgets)
# ===========================================
NUXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxx
OPENWEATHER_API_KEY=your-openweather-key

# ===========================================
# BRANDING DEFAULTS  (optional — fallback logo/icon Directus file ids)
# ===========================================
# NUXT_PUBLIC_DEFAULT_LOGO_ID=
# NUXT_PUBLIC_DEFAULT_ICON_ID=

# ===========================================
# SENDGRID EMAIL  (optional — transactional + org email engine)
# ===========================================
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Universal invite template (email_type: "invitation" | "welcome" | "accepted").
SENDGRID_INVITE_EMAIL_TEMPLATE_ID=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Org email template (newsletters, announcements, branded sends).
SENDGRID_EMAIL_TEMPLATE_ID=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Signed Event Webhook verification key (base64) from SendGrid → Settings → Mail
# Settings → Signed Event Webhook. When set, /api/email/activity rejects forged
# posts; leave unset to accept events unverified (a warning is logged).
# SENDGRID_WEBHOOK_PUBLIC_KEY=

# ===========================================
# STRIPE  (optional — dues via Connect + agency subscriptions)
# ===========================================
# Mode: "test" or "live". Unset → derived from NODE_ENV (live only in production).
# Set STRIPE_MODE=test to run even the PRODUCTION instance against test Stripe for
# full onboarding + payment dry-runs before going live. Flip to "live" (or remove)
# when ready. Controls which key pair + webhook secret below are used.
STRIPE_MODE=test
STRIPE_PUBLIC_KEY_TEST=pk_test_xxxxx
STRIPE_SECRET_KEY_TEST=sk_test_xxxxx
STRIPE_PUBLIC_KEY_LIVE=pk_live_xxxxx
STRIPE_SECRET_KEY_LIVE=sk_live_xxxxx
# Webhook signing secret. Use the single base var, OR set per-mode secrets so a test
# and a live webhook endpoint can coexist (server picks by STRIPE_MODE, falls back to base).
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# STRIPE_WEBHOOK_SECRET_TEST=whsec_xxxxx
# STRIPE_WEBHOOK_SECRET_LIVE=whsec_xxxxx
# Platform fee percent on resident dues via Stripe Connect (default "2").
STRIPE_CONNECT_FEE_PERCENT=2
# Recurring Price ids for agency (multi-property) billing — see docs/stripe-setup.md.
STRIPE_AGENCY_PRICE_ID_MONTHLY=price_xxxxx
STRIPE_AGENCY_PRICE_ID_YEARLY=price_xxxxx
# Recurring Price ids for storage add-ons (per mode) — see core/shared/billing/addons.ts.
# Toggling "Extra Storage (+100 GB)" adds/removes a subscription item at this price.
STRIPE_PRICE_ADDON_STORAGE_100_TEST=price_xxxxx
STRIPE_PRICE_ADDON_STORAGE_100_LIVE=price_xxxxx

# ===========================================
# FILE STORAGE  (optional — sensible defaults if unset)
# ===========================================
# Per-file upload cap in MB (default 250). Enforced as HTTP 413 before write.
STORAGE_MAX_FILE_MB=250
# Storage floor (GB) for orgs with no paid plan (default 5).
STORAGE_FREE_GB=5
# Image optimization (sharp) tunables — used on upload, optimize, and sweep.
IMAGE_MAX_EDGE=2560
IMAGE_JPEG_QUALITY=82
IMAGE_WEBP_QUALITY=82
# NOTE: the DigitalOcean Spaces storage backend is a DIRECTUS server config, not
# an app env var. See docs/storage-spaces-migration.md.

# ===========================================
# SCHEDULED FLOWS  (optional — Directus cron → app)
# ===========================================
# Shared secret the scheduled-email Directus flow sends back to the app, AND the
# hourly notification-digest cron (x-cron-secret / Authorization: Bearer $CRON_SECRET).
# The digest is triggered by a crontab on the DigitalOcean droplet hitting
# /api/cron/notification-digest — see docs/notification-digest-cron.md. Set the same
# value on the app env (Vercel) and the droplet crontab.
CRON_SECRET=your-long-random-cron-secret
# Platform timezone the digest cron uses when a member has no directus_users.timezone.
DIGEST_TZ=America/New_York

# ===========================================
# AI ASSISTANT + TOKEN ECONOMY  (optional — Phase 1, in progress)
# ===========================================
# Anthropic key for the metered "Draft with AI" composer + credit economy.
# Not referenced by code yet; required once the draft route lands.
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# ===========================================
# 1033 DATA MIGRATION  (optional — only for `pnpm migrate:1033`)
# ===========================================
# SOURCE_1033_DIRECTUS_URL=https://source-directus-instance.com
# SOURCE_1033_TOKEN=source-instance-token

# ===========================================
# LOCAL ADMIN / SEED SCRIPTS  (optional)
# ===========================================
# Admin login used by some local seed/maintenance scripts.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me

# ===========================================
# DIRECTUS NATIVE OAUTH  (optional — configured on the Directus side)
# ===========================================
# AUTH_PROVIDERS=google
# AUTH_GOOGLE_DRIVER=openid
# AUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# AUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
# AUTH_GOOGLE_ISSUER_URL=https://accounts.google.com
# AUTH_GOOGLE_IDENTIFIER_KEY=email
# AUTH_GOOGLE_ALLOW_PUBLIC_REGISTRATION=true
# AUTH_GOOGLE_DEFAULT_ROLE_ID=your-default-role-uuid
# AUTH_GOOGLE_ICON=google
