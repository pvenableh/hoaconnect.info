# ---- Bespoke single-building app environment ----
# Copy to .env for local dev. In production, set these in the app's own Vercel
# project (Root Directory = apps/<client>). Env var names match core exactly.

# Which building this app serves (the org's slug in Directus). No org-picker —
# the whole app is locked to this one org. Leave empty to bind by custom domain.
NUXT_PUBLIC_ORG_SLUG=1033-lenox

# This app's OWN session secret → its own same-origin cookie. MUST be unique per
# app/domain and at least 32 chars. (Independent login per domain; no SSO.)
NUXT_SESSION_PASSWORD=change-me-to-a-unique-32+-char-secret

# SHARED backend — identical across all HOA Connect apps.
DIRECTUS_URL=https://your-directus-instance
DIRECTUS_STATIC_TOKEN=your-directus-static-token
DIRECTUS_WEBSOCKET_URL=wss://your-directus-instance/websocket

# Public app URL (this building's domain in prod).
APP_URL=http://localhost:3000

# Optional integrations (inherited from core; set only what this building uses).
# STRIPE_SECRET_KEY_TEST=
# STRIPE_PUBLIC_KEY_TEST=
# STRIPE_WEBHOOK_SECRET=
# SENDGRID_API_KEY=
# ANTHROPIC_API_KEY=
# OPENWEATHER_API_KEY=
# NUXT_PUBLIC_MAPBOX_TOKEN=
